# All plans use owner-supplied FastPayDirect links in src/content/payments.ts.
# Optional Stripe overrides for Elite and Premium, read during the build:
# disabled = use the supplied FastPayDirect links (the default).
# test/live = use only the Stripe links below; blank overrides disable that plan.
# A missing test link never falls back to the live FastPayDirect checkout.
# Standard always uses its supplied link, independently of these overrides.
# Allowed values: disabled, test, live
STRIPE_PAYMENT_MODE=disabled
STRIPE_ELITE_PAYMENT_LINK=
STRIPE_PREMIUM_PAYMENT_LINK=

# Do not add Stripe secret keys or webhook signing secrets to this static site.
# Store those in the selected automation service or backend's secret storage.
